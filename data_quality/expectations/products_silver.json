{
  "expectation_suite_name": "products_silver",
  "meta": {
    "notes": "Silver product quality gate. Failures stop the pipeline; bad bronze rows are already in quarantine/."
  },
  "expectations": [
    {"expectation_type": "expect_table_row_count_to_be_between", "kwargs": {"min_value": 100, "max_value": 100000}},
    {"expectation_type": "expect_column_to_exist", "kwargs": {"column": "product_id"}},
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "product_id"}},
    {"expectation_type": "expect_column_values_to_be_unique", "kwargs": {"column": "product_id"}},
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "brand"}},
    {"expectation_type": "expect_column_values_to_be_between", "kwargs": {"column": "price", "min_value": 0, "max_value": 2500}},
    {"expectation_type": "expect_column_values_to_be_between", "kwargs": {"column": "rating", "min_value": 0, "max_value": 5}}
  ]
}
