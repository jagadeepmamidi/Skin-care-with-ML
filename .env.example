# Skincare Intelligence Data Platform
# Copy to .env and adjust. Defaults work for local filesystem + DuckDB.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Object storage: local | minio | s3
LAKE_BACKEND=local
LAKE_ROOT=./data/lake
S3_BUCKET=skincare-lake
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# Warehouse: duckdb | postgres
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/warehouse/skincare.duckdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skincare
POSTGRES_USER=skincare
POSTGRES_PASSWORD=skincare

# Product API (docker-compose service or local uvicorn)
PRODUCT_API_URL=http://localhost:8088
MAKEUP_API_URL=http://makeup-api.herokuapp.com/api/v1/products.json
MAKEUP_API_ENABLED=true

# Pipeline volumes
EVENT_COUNT=1000000
PRICE_DAYS=90
INCREMENTAL=true

# Kafka / Redpanda (optional streaming profile)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=skincare.events

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false
